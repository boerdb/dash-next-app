# Kopieer naar .secrets.local (gitignored). Niet committen.
# SSH naar Next-productieserver (deploy-scripts)
NEXT_HOST=192.168.1.32
DB_HOST=192.168.1.14
SSH_USER=root
# SSH logt in met een sleutel (geen wachtwoord meer):
# SSH_KEY_PATH=~/.ssh/id_ed25519_homelab
# SSH_KEY_PASSPHRASE=
# Oudere scripts gebruiken SSH_PASS nog als MySQL-root-wachtwoord (mysql -u root -p...).
SSH_PASS=
MYSQL_ROOT_PASS=
# App-DB-users op .14
DASH_APP_DB_PASS=
BEN_DB_PASS=
PHPMYADMIN_APP_PASS=

# Oude migratiescripts kunnen nog PHP_HOST=192.168.1.52 verwachten (host uitgefaseerd).
